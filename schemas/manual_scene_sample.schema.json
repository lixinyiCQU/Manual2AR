{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manual2ar.local/schemas/manual_scene_sample.schema.json",
  "title": "Manual2AR manual-scene training sample",
  "type": "object",
  "required": [
    "sample_id",
    "device_id",
    "task_id",
    "observation",
    "manual_context",
    "label"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "observation": {
      "type": "object",
      "required": [
        "image_paths"
      ],
      "properties": {
        "image_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "view_quality": {
          "enum": [
            "clear",
            "occluded",
            "blurred",
            "out_of_frame",
            "unknown"
          ]
        },
        "sensor_values": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "manual_context": {
      "type": "object",
      "required": [
        "manual_id",
        "candidate_step_ids"
      ],
      "properties": {
        "manual_id": {
          "type": "string"
        },
        "candidate_step_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_region_xyxy": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "source_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "required": [
        "current_step_id",
        "status",
        "safe_to_advance"
      ],
      "properties": {
        "previous_step_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_step_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "completed",
            "wrong_operation",
            "uncertain"
          ]
        },
        "error_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_component_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_bbox_xyxy": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "target_mask_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "safe_to_advance": {
          "type": "boolean"
        },
        "next_step_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
