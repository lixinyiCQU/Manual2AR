  "requirements": [
    {
      "id": "r.base.install",
      "kind": "operation",
      "source_id": "official.base",
      "quote": "来安装料盘支架底座"
    },
    {
      "id": "r.base.quantity",
      "kind": "specification",
      "source_id": "official.base",
      "quote": "2 颗"
    },
    {
      "id": "r.base.specification",
      "kind": "material_selection",
      "source_id": "official.base",
      "quote": "M3-8"
    },
    {
      "id": "r.base.direction",
      "kind": "outcome",
      "source_id": "official.base",
      "quote": "请注意安装方向。"
    },
    {
      "id": "r.holder.slide",
      "kind": "operation",
      "source_id": "official.holder",
      "quote": "从上向下滑入料盘支架。"
    },
    {
      "id": "r.holder.direction",
      "kind": "outcome",
      "source_id": "official.holder",
      "quote": "请确保料盘支架方向与插槽方向相匹配。"
    },
    {
      "id": "r.optional",
      "kind": "applicability",
      "source_id": "official.optional",
      "quote": "如果您计划使用 AMS lite，您可以选择性地安装料盘支架，而不是一定需要安装。"
    },
    {
      "id": "r.base.mount",
      "kind": "outcome",
      "source_id": "reference.base",
      "quote": "灰色底座已贴靠在立柱正确安装区域"
    },
    {
      "id": "r.base.screws",
      "kind": "outcome",
      "source_id": "reference.base",
      "quote": "上下两颗固定螺丝均可见且处于安装孔位"
    },
    {
      "id": "r.base.appearance",
      "kind": "outcome",
      "source_id": "reference.base",
      "quote": "未见明显缺件、脱离或倾斜。"
    },
    {
      "id": "r.base.secure",
      "kind": "outcome",
      "source_id": "reference.base",
      "quote": "用户仍需按官方步骤人工确认机械紧固。"
    },
    {
      "id": "r.base.boundary",
      "kind": "observation_boundary",
      "source_id": "reference.base",
      "quote": "只检查可见安装状态，不判断扭矩、螺丝是否真正拧紧、隐藏卡扣或内部结构。"
    },
    {
      "id": "r.holder.connection",
      "kind": "outcome",
      "source_id": "reference.holder",
      "quote": "安装端与打印机立柱的底座区域有清楚可见的连接"
    },
    {
      "id": "r.holder.appearance",
      "kind": "outcome",
      "source_id": "reference.holder",
      "quote": "且无明显脱离或大幅倾斜。"
    },
    {
      "id": "r.holder.occlusion",
      "kind": "observation_boundary",
      "source_id": "reference.holder",
      "quote": "底座会被装好的支架遮住，不要求看见底座螺丝、隐藏插槽、卡扣或细微缝隙。"
    },
    {
      "id": "r.holder.boundary",
      "kind": "observation_boundary",
      "source_id": "reference.holder",
      "quote": "结论仅限可见安装状态，不表示机械锁紧或安全放行。"
    },
    {
      "id": "r.base.reference_instruction",
      "kind": "operation",
      "source_id": "reference.base_instruction",
      "quote": "使用两颗 M3-8 螺丝固定料盘支架底座，注意官方图示方向。画面同时提示两颗螺丝的位置；紧固程度请按官方说明人工确认。"
    },
    {
      "id": "r.holder.reference_instruction",
      "kind": "operation",
      "source_id": "reference.holder_instruction",
      "quote": "从上向下滑入料盘支架，确保方向与插槽匹配。"
    },
    {
      "id": "r.chapter.outcome",
      "kind": "outcome",
      "source_id": "reference.chapter",
      "quote": "料盘支架底座与安装面贴合，支架已沿匹配插槽滑入，无明显倾斜。"
    }
  ],
